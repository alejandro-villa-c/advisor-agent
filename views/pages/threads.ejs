<div class="app-shell">
  <aside class="sidebar" aria-label="Sidebar">
    <div class="sidebar__brand">
      <div class="sidebar__logo">A</div>
      <div class="sidebar__title">Advisor Agent</div>
    </div>

    <button class="sidebar__new-thread" type="button">
      <span class="sidebar__new-thread-plus">+</span>
      <span>New thread</span>
    </button>

    <div class="sidebar__section-title">History</div>

    <nav class="sidebar__threads" aria-label="Threads">
      <a class="thread thread--active" href="/chat">
        <div class="thread__title">Ask Anything</div>
        <div class="thread__meta">All meetings</div>
      </a>

      <a class="thread" href="/chat">
        <div class="thread__title">Follow-ups</div>
        <div class="thread__meta">Last week</div>
      </a>

      <a class="thread" href="/chat">
        <div class="thread__title">Client questions</div>
        <div class="thread__meta">Last month</div>
      </a>
    </nav>

    <div class="sidebar__footer">
      <div class="sidebar__user">
        <div class="sidebar__avatar">G</div>
        <div class="sidebar__user-text">
          <div class="sidebar__user-name">Guest</div>
          <div class="sidebar__user-meta">Not connected</div>
        </div>
      </div>
    </div>
  </aside>

  <main class="main-area" aria-label="Threads">
    <!-- Desktop: do NOT repeat threads/profile (sidebar already has it) -->
    <section class="threads-desktop" aria-label="Desktop threads landing">
      <div class="threads-desktop__inner">
        <div class="threads-desktop__badge">Threads</div>
        <h1 class="threads-desktop__title">Pick up where you left off</h1>
        <p class="threads-desktop__subtitle">
          Select a thread from the sidebar, or start a new conversation.
        </p>

        <div class="threads-desktop__actions">
          <a class="btn btn--primary" href="/chat">Open chat</a>
          <button class="btn btn--ghost" type="button">New thread</button>
        </div>

        <div class="threads-desktop__status">
          <div class="status-chip">
            <span class="status-chip__label">Gmail</span>
            <span class="status-chip__value">Not connected</span>
          </div>
          <div class="status-chip">
            <span class="status-chip__label">Calendar</span>
            <span class="status-chip__value">Not connected</span>
          </div>
          <div class="status-chip">
            <span class="status-chip__label">HubSpot</span>
            <span class="status-chip__value">Not connected</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Mobile: this IS the threads screen (since sidebar is hidden) -->
    <section class="threads-mobile" aria-label="Mobile threads">
      <div class="threads-page">
        <header class="threads-page__header">
          <div class="threads-page__brand">
            <div class="threads-page__logo">A</div>
            <div class="threads-page__brand-text">
              <div class="threads-page__brand-name">Advisor Agent</div>
              <div class="threads-page__brand-sub">Threads</div>
            </div>
          </div>

          <a class="threads-page__cta" href="/chat">Open chat</a>
        </header>

        <div class="threads-page__list" role="list">
          <a class="thread-card" href="/chat" role="listitem">
            <div class="thread-card__title">Ask Anything</div>
            <div class="thread-card__meta">Context: all meetings</div>
          </a>

          <a class="thread-card" href="/chat" role="listitem">
            <div class="thread-card__title">Follow-ups</div>
            <div class="thread-card__meta">Last updated: last week</div>
          </a>

          <a class="thread-card" href="/chat" role="listitem">
            <div class="thread-card__title">Client questions</div>
            <div class="thread-card__meta">Last updated: last month</div>
          </a>
        </div>

        <div class="threads-page__footer">
          <div class="threads-user">
            <div class="threads-user__avatar">G</div>
            <div class="threads-user__text">
              <div class="threads-user__name">Guest</div>
              <div class="threads-user__meta">Not connected</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</div>
