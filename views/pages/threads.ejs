<div class="app-shell">
  <%- include('../partials/sidebar', { active: 'threads' }) %>

  <main class="main-area" aria-label="Threads">
    <!-- Desktop -->
    <section class="threads-desktop" aria-label="Desktop threads landing">
      <div class="center-page">
        <div class="center-card">
          <div class="page-badge">Threads</div>
          <h1 class="page-title">Your threads are in the sidebar</h1>
          <p class="page-subtitle">
            Start a new conversation or select a thread from the history list.
          </p>

          <div class="page-actions">
            <button class="btn btn--primary" type="button" data-new-thread>+ New thread</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Mobile -->
    <section class="threads-mobile" aria-label="Mobile threads">
      <div class="threads-page">
        <header class="threads-page__header">
          <div class="threads-page__brand">
            <div class="threads-page__logo">A</div>
            <div class="threads-page__brand-text">
              <div class="threads-page__brand-name">Advisor Agent</div>
              <div class="threads-page__brand-sub">Threads</div>
            </div>
          </div>

          <button class="btn btn--primary" type="button" data-new-thread>+ New thread</button>
        </header>

        <div class="threads-page__list" role="list">
          <a class="thread-card" href="/settings" role="listitem">
            <div class="thread-card__title">Settings</div>
            <div class="thread-card__meta">Connections</div>
          </a>
        </div>

        <div class="threads-section-title">History</div>

        <div class="threads-page__list" role="list" data-threads-list>
          <div class="thread-card-row" role="listitem" aria-busy="true">
            <div class="thread-card">
              <div class="thread-card__title">Loading…</div>
              <div class="thread-card__meta">Please wait</div>
            </div>
          </div>
        </div>

        <div class="threads-page__footer">
          <% if (locals.currentUser) { %>
            <div class="threads-user">
              <div class="threads-user__avatar"><%= locals.currentUser.initials %></div>
              <div class="threads-user__text">
                <div class="threads-user__name"><%= locals.currentUser.name || locals.currentUser.email %></div>
                <div class="threads-user__meta"><%= locals.currentUser.email %></div>
              </div>
            </div>

            <div style="margin-top: 12px;">
              <a class="btn btn--ghost" style="width:100%;" href="/auth/logout">Logout</a>
            </div>
          <% } %>
        </div>
      </div>
    </section>
  </main>
</div>

<script src="/js/threads.js" defer></script>
