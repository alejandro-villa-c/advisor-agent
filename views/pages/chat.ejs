<div class="app-shell">
  <%- include('../partials/sidebar', { active: 'chat' }) %>

  <main class="main-area" aria-label="Chat">
    <div class="panel" data-thread-id="<%= threadId %>">
      <header class="panel__header">
        <h1 class="panel__title">Ask Anything</h1>
        <!-- Mobile close -->
        <a class="icon-btn" href="/threads" aria-label="Close">✕</a>
      </header>

      <div class="panel__tabs">
        <div class="tabs">
          <button class="tab tab--active" type="button">Chat</button>
          <button class="tab" type="button">History</button>
        </div>
      </div>

      <main class="content">
        <div class="content__inner">
          <!-- Messages are rendered by /public/js/chat.js -->
        </div>
      </main>

      <footer class="composer">
        <div class="composer__inner">
          <div class="composer__box">
            <div class="composer__input-wrap">
              <textarea
                class="composer__input"
                rows="2"
                placeholder="Ask anything…"></textarea>

              <button class="send-btn" type="button" aria-label="Send" disabled>
                <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill="currentColor" d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z"></path>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </main>
</div>

<script src="/js/chat.js"></script>
