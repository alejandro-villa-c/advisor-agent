<%
  // Format ISO timestamps coming from integrationStates.state.lastSyncedAt
  // Displayed in Dominican Republic time.
  const TIME_ZONE = 'America/Santo_Domingo';

  function formatSyncDate(value) {
    if (!value || typeof value !== 'string') return '—';

    const ms = Date.parse(value);
    if (!Number.isFinite(ms)) return value; // fallback if not parseable

    const d = new Date(ms);

    return new Intl.DateTimeFormat('en-US', {
      timeZone: TIME_ZONE,
      dateStyle: 'medium',
      timeStyle: 'short',
      // hour12: false, // uncomment if you prefer 24h
    }).format(d);
  }
%>

<div class="app-shell">
  <%- include('../partials/sidebar', { active: 'settings' }) %>

  <main class="main-area" aria-label="Settings">
    <div class="center-page">
      <div class="center-card">
        <!-- Mobile-only nav tabs (mirrors Chat page tabs) -->
        <div class="page-tabs" aria-label="Page navigation">
          <div class="tabs">
            <div class="tabs__left">
              <a class="tab tab--active" href="/settings" aria-current="page">Settings</a>
              <a class="tab" href="/threads">History</a>
            </div>
          </div>
        </div>

        <div class="page-badge page-badge--desktop">Settings</div>
        <h1 class="page-title">Connections</h1>
        <p class="page-subtitle">
          Connect your accounts so the agent can retrieve context and take actions.
        </p>

        <% if (flash) { %>
          <div class="notice <%= flash.type === 'success' ? 'notice--success' : 'notice--error' %>">
            <%= flash.message %>
          </div>
        <% } %>

        <div class="page-status">
          <div class="status-chip">
            <span class="status-chip__label">Google</span>
            <span class="status-chip__value"><%= connections.google ? 'Connected' : 'Not connected' %></span>
          </div>

          <div class="status-chip">
            <span class="status-chip__label">HubSpot</span>
            <span class="status-chip__value"><%= connections.hubspot ? 'Connected' : 'Not connected' %></span>
          </div>
        </div>

        <div class="page-actions" style="margin-top: 18px; display:flex; gap:10px; flex-wrap:wrap;">
          <% if (!connections.google) { %>
            <a class="btn btn--primary" href="/auth/google">Connect Google</a>
          <% } %>

          <% if (!connections.hubspot) { %>
            <a class="btn btn--primary" href="/auth/hubspot">Connect HubSpot</a>
          <% } else { %>
            <form method="post" action="/settings/hubspot/test">
              <button class="btn btn--ghost" type="submit">Test HubSpot</button>
            </form>

            <form method="post" action="/settings/hubspot/disconnect" onsubmit="return confirm('Disconnect HubSpot?');">
              <button class="btn btn--ghost" type="submit">Disconnect HubSpot</button>
            </form>
          <% } %>
        </div>

        <% if (hubspotDebug) { %>
          <div class="card" style="margin-top:16px;">
            <div class="card__title" style="margin-bottom:6px;">HubSpot Debug</div>
            <div style="font-size: 14px; opacity: .9;">
              <div><strong>Hub:</strong> <%= hubspotDebug.hubDomain %></div>
              <div><strong>User:</strong> <%= hubspotDebug.hubUserEmail %></div>
              <div><strong>Expires in:</strong> <%= hubspotDebug.expiresIn %> seconds</div>
              <div style="margin-top:6px;"><strong>Scopes:</strong> <%= hubspotDebug.scopes.join(', ') %></div>
            </div>
          </div>
        <% } %>

        <div class="card" style="margin-top:16px;">
          <div class="card__title" style="margin-bottom:6px;">Sync status</div>
          <div style="font-size: 14px; opacity: .9;">
            Recent sync activity for connected integrations.
          </div>

          <div style="margin-top:10px; font-size: 14px;">
            <div style="display:flex; gap:12px; flex-wrap:wrap;">
              <div class="status-chip">
                <span class="status-chip__label">Gmail last sync</span>
                <span class="status-chip__value">
                  <%= formatSyncDate(syncState && syncState.gmail && syncState.gmail.lastSyncedAt) %>
                </span>
              </div>

              <div class="status-chip">
                <span class="status-chip__label">Calendar last sync</span>
                <span class="status-chip__value">
                  <%= formatSyncDate(syncState && syncState.calendar && syncState.calendar.lastSyncedAt) %>
                </span>
              </div>

              <div class="status-chip">
                <span class="status-chip__label">HubSpot contacts last sync</span>
                <span class="status-chip__value">
                  <%= formatSyncDate(syncState && syncState.hubspotContacts && syncState.hubspotContacts.lastSyncedAt) %>
                </span>
              </div>

              <div class="status-chip">
                <span class="status-chip__label">HubSpot notes last sync</span>
                <span class="status-chip__value">
                  <%= formatSyncDate(syncState && syncState.hubspotNotes && syncState.hubspotNotes.lastSyncedAt) %>
                </span>
              </div>

              <div class="status-chip">
                <span class="status-chip__label">Gmail ingested</span>
                <span class="status-chip__value"><%= counts ? counts.gmailMessages : 0 %> emails</span>
              </div>

              <div class="status-chip">
                <span class="status-chip__label">Calendar ingested</span>
                <span class="status-chip__value"><%= counts ? counts.calendarEvents : 0 %> events</span>
              </div>

              <div class="status-chip">
                <span class="status-chip__label">HubSpot contacts ingested</span>
                <span class="status-chip__value"><%= counts ? counts.hubspotContacts : 0 %> contacts</span>
              </div>

              <div class="status-chip">
                <span class="status-chip__label">HubSpot notes ingested</span>
                <span class="status-chip__value"><%= counts ? counts.hubspotNotes : 0 %> notes</span>
              </div>

              <div class="status-chip">
                <span class="status-chip__label">RAG documents</span>
                <span class="status-chip__value"><%= counts ? counts.documents : 0 %></span>
              </div>

              <div class="status-chip">
                <span class="status-chip__label">RAG chunks</span>
                <span class="status-chip__value"><%= counts ? counts.documentChunks : 0 %></span>
              </div>
            </div>

            <div style="margin-top:10px; opacity:.85;">
              Manual sync is optional. In production, sync jobs typically run automatically on a schedule.
            </div>
          </div>
        </div>

        <div class="card" style="margin-top:16px;">
          <div class="card__title" style="margin-bottom:6px;">Manual sync (optional)</div>
          <div style="font-size: 14px; opacity: .9;">
            Use these to pull data into the database. Defaults are conservative to avoid huge imports.
            After sync, new/changed documents are automatically queued for RAG embedding.
          </div>

          <div class="page-actions" style="margin-top: 12px; display:flex; gap:10px; flex-wrap:wrap;">
            <% if (connections.hubspot) { %>
              <form method="post" action="/settings/sync/hubspot/contacts">
                <button class="btn btn--ghost" type="submit">Sync HubSpot contacts</button>
              </form>

              <form method="post" action="/settings/sync/hubspot/notes">
                <button class="btn btn--ghost" type="submit">Sync HubSpot notes</button>
              </form>
            <% } %>

            <% if (connections.google) { %>
              <form method="post" action="/settings/sync/gmail" onsubmit="return confirm('Queue Gmail backfill? This will ingest thousands of emails.');">
                <button class="btn btn--ghost" type="submit">Sync Gmail (Backfill)</button>
              </form>

              <form method="post" action="/settings/sync/calendar">
                <button class="btn btn--ghost" type="submit">Sync Calendar</button>
              </form>
            <% } %>
          </div>
        </div>

        <div class="card" style="margin-top:16px;">
          <div class="card__title" style="margin-bottom:6px;">RAG indexing</div>
          <div style="font-size: 14px; opacity: .9;">
            Usually you don’t need this manually (sync queues embedding automatically).
            This button is a maintenance tool to rebuild chunks and embed any missing chunks.
          </div>

          <div class="page-actions" style="margin-top: 12px; display:flex; gap:10px; flex-wrap:wrap;">
            <form method="post" action="/settings/rag/rebuild-and-embed" onsubmit="return confirm('Queue RAG rebuild + embed?');">
              <button class="btn btn--primary" type="submit">Rebuild + Embed</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
