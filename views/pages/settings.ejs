<div class="app-shell">
  <%- include('../partials/sidebar', { active: 'settings' }) %>

  <main class="main-area">
    <div class="threads-desktop">
      <div class="threads-desktop__inner">
        <div class="threads-desktop__badge">Settings</div>
        <h1 class="threads-desktop__title">Connections</h1>
        <p class="threads-desktop__subtitle">
          Connect your accounts so the agent can retrieve context and take actions.
        </p>

        <% if (flash) { %>
          <div class="notice <%= flash.type === 'success' ? 'notice--success' : 'notice--error' %>">
            <%= flash.message %>
          </div>
        <% } %>

        <div class="threads-desktop__status">
          <div class="status-chip">
            <span class="status-chip__label">Google</span>
            <span class="status-chip__value"><%= connections.google ? 'Connected' : 'Not connected' %></span>
          </div>

          <div class="status-chip">
            <span class="status-chip__label">HubSpot</span>
            <span class="status-chip__value"><%= connections.hubspot ? 'Connected' : 'Not connected' %></span>
          </div>
        </div>

        <div class="threads-desktop__actions" style="margin-top: 18px; display:flex; gap:10px; flex-wrap:wrap;">
          <% if (!connections.google) { %>
            <a class="btn btn--primary" href="/auth/google">Connect Google</a>
          <% } else { %>
            <a class="btn btn--ghost" href="/chat">Go to chat</a>
          <% } %>

          <% if (!connections.hubspot) { %>
            <a class="btn btn--primary" href="/auth/hubspot">Connect HubSpot</a>
          <% } else { %>
            <form method="post" action="/settings/hubspot/test">
              <button class="btn btn--ghost" type="submit">Test HubSpot</button>
            </form>

            <form method="post" action="/settings/hubspot/disconnect" onsubmit="return confirm('Disconnect HubSpot?');">
              <button class="btn btn--ghost" type="submit">Disconnect HubSpot</button>
            </form>
          <% } %>
        </div>

        <% if (hubspotDebug) { %>
          <div class="card" style="margin-top:16px;">
            <div class="card__title" style="margin-bottom:6px;">HubSpot Debug</div>
            <div style="font-size: 14px; opacity: .9;">
              <div><strong>Hub:</strong> <%= hubspotDebug.hubDomain %> (ID: <%= hubspotDebug.hubId %>)</div>
              <div><strong>User:</strong> <%= hubspotDebug.hubUserEmail %></div>
              <div><strong>Expires in:</strong> <%= hubspotDebug.expiresIn %> seconds</div>
              <div style="margin-top:6px;"><strong>Scopes:</strong> <%= hubspotDebug.scopes.join(', ') %></div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>
