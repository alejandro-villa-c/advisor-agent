<div class="app-shell">
  <%- include('../partials/sidebar', { active: 'instructions' }) %>

  <main class="main-area" aria-label="Instructions">
    <div class="center-page">
      <div class="center-card">
        <div class="page-tabs" aria-label="Page navigation">
          <div class="tabs">
            <div class="tabs__left">
              <a class="tab" href="/settings">Settings</a>
              <a class="tab tab--active" href="/instructions" aria-current="page">Instructions</a>
              <a class="tab" href="/threads">History</a>
            </div>
          </div>
        </div>

        <div class="page-badge page-badge--desktop">Automation</div>
        <h1 class="page-title">Ongoing Instructions</h1>
        <p class="page-subtitle">
          Set up rules that the agent will follow automatically when events happen.
        </p>

        <!-- System Info Banner -->
        <div class="instructions-system-info">
          <div class="instructions-system-info__item">
            <span class="instructions-system-info__icon">🔄</span>
            <span class="instructions-system-info__text">
              <strong>Polling:</strong> Triggers are checked every <strong>60 seconds</strong>
            </span>
          </div>
          <div class="instructions-system-info__item">
            <span class="instructions-system-info__icon">⚡</span>
            <span class="instructions-system-info__text">
              <strong>Real-time:</strong> Activity logs update instantly via WebSocket
            </span>
          </div>
          <div class="instructions-system-info__item">
            <span class="instructions-system-info__icon">🛡️</span>
            <span class="instructions-system-info__text">
              <strong>Loop Prevention:</strong> Actions triggered by the agent itself are automatically skipped
            </span>
          </div>
          <div class="instructions-system-info__item">
            <span class="instructions-system-info__icon">🔒</span>
            <span class="instructions-system-info__text">
              <strong>Idempotency:</strong> Each trigger is processed only once, even across restarts
            </span>
          </div>
        </div>

        <% if (locals.flash) { %>
          <div class="notice <%= locals.flash.type === 'success' ? 'notice--success' : 'notice--error' %>">
            <%= locals.flash.message %>
          </div>
        <% } %>

        <!-- Rate Limit Indicator -->
        <div class="instructions-rate-limit" id="rate-limit-bar">
          <div class="instructions-rate-limit__label">
            Proactive actions this hour: <span id="rate-limit-count">—</span> / <span id="rate-limit-max">50</span>
          </div>
          <div class="instructions-rate-limit__bar">
            <div class="instructions-rate-limit__fill" id="rate-limit-fill" style="width: 0%"></div>
          </div>
        </div>

        <!-- Create New Instruction -->
        <div class="instructions-create">
          <form id="create-instruction-form">
            <input 
              type="text" 
              class="instructions-create__input" 
              name="instruction"
              placeholder="e.g., When someone emails me that's not in HubSpot, create a contact..."
              required
            >
            <div class="instructions-create__actions">
              <button type="submit" class="btn btn--primary">Add Instruction</button>
              <button type="button" class="btn btn--ghost" id="show-reference-btn" title="Show available triggers and tools">
                ❓ Reference
              </button>
            </div>
          </form>
        </div>

        <!-- Reference Panel (Hidden by default) -->
        <div class="instructions-reference" id="reference-panel" style="display: none;">
          <div class="instructions-reference__header">
            <h3>📚 Available Triggers & Tools</h3>
            <button type="button" class="instructions-reference__close" id="close-reference-btn">✕</button>
          </div>
          
          <div class="instructions-reference__content">
            <div class="instructions-reference__section">
              <h4>🎯 Triggers (When...)</h4>
              <p class="instructions-reference__hint">Your instruction can respond to these events:</p>
              
              <div class="instructions-reference__category">
                <strong>Gmail</strong>
                <ul>
                  <li><code>When I receive an email</code> - Triggers when you get a new email</li>
                  <li><code>When I send an email</code> - Triggers when you send an email</li>
                </ul>
              </div>
              
              <div class="instructions-reference__category">
                <strong>Calendar</strong>
                <ul>
                  <li><code>When a calendar event is created</code></li>
                  <li><code>When a calendar event is updated</code></li>
                  <li><code>When a calendar event is deleted</code></li>
                </ul>
              </div>
              
              <div class="instructions-reference__category">
                <strong>HubSpot</strong>
                <ul>
                  <li><code>When a contact is created in HubSpot</code></li>
                  <li><code>When a contact is updated in HubSpot</code></li>
                  <li><code>When a contact is deleted from HubSpot</code></li>
                  <li><code>When a note is added to a contact</code></li>
                </ul>
              </div>
            </div>
            
            <div class="instructions-reference__section">
              <h4>🔧 Tools (Do...)</h4>
              <p class="instructions-reference__hint">The agent can perform these actions:</p>
              
              <div class="instructions-reference__category">
                <strong>Gmail</strong>
                <ul>
                  <li><code>Send an email</code></li>
                  <li><code>Reply to an email</code></li>
                  <li><code>Search for emails</code></li>
                </ul>
              </div>
              
              <div class="instructions-reference__category">
                <strong>Calendar</strong>
                <ul>
                  <li><code>Create a calendar event</code></li>
                  <li><code>Update a calendar event</code></li>
                  <li><code>Delete a calendar event</code></li>
                  <li><code>Look up/find calendar events</code></li>
                </ul>
              </div>
              
              <div class="instructions-reference__category">
                <strong>HubSpot</strong>
                <ul>
                  <li><code>Create a contact</code></li>
                  <li><code>Update a contact</code></li>
                  <li><code>Delete a contact</code></li>
                  <li><code>Find a contact</code></li>
                  <li><code>Add a note to a contact</code></li>
                </ul>
              </div>
            </div>
            
            <div class="instructions-reference__section">
              <h4>💡 Example Instructions</h4>
              <ul class="instructions-reference__examples">
                <li>"When someone emails me that's not in HubSpot, create a contact with a note about the email"</li>
                <li>"When I create a contact in HubSpot, send them a welcome email"</li>
                <li>"When someone asks about our next meeting, look it up on the calendar and reply"</li>
                <li>"When I add an event to my calendar, email the attendees to let them know"</li>
                <li>"When a client replies to my email, add a note to their HubSpot contact"</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Global Actions -->
        <div class="instructions-toolbar">
          <div class="instructions-toolbar__left">
            <span class="instructions-toolbar__count" id="instruction-count">0 instructions</span>
          </div>
          <div class="instructions-toolbar__right">
            <button class="btn btn--ghost btn--small" id="pause-all-btn" title="Pause All">
              ⏸️ Pause All
            </button>
            <button class="btn btn--ghost btn--small" id="resume-all-btn" title="Resume All">
              ▶️ Resume All
            </button>
          </div>
        </div>

        <!-- Tabs -->
        <div class="instructions-tabs">
          <button class="instructions-tabs__btn instructions-tabs__btn--active" data-tab="instructions">
            📋 Instructions
          </button>
          <button class="instructions-tabs__btn" data-tab="activity">
            📊 Activity Log
          </button>
        </div>

        <!-- Instructions Tab -->
        <div class="instructions-tab-content instructions-tab-content--active" id="tab-instructions">
          <div id="instructions-list">
            <div class="instructions-empty">
              <div class="instructions-empty__icon">📋</div>
              <div class="instructions-empty__title">No instructions yet</div>
              <div class="instructions-empty__text">
                Create your first ongoing instruction above. Click <strong>Reference</strong> to see available triggers and tools.
              </div>
            </div>
          </div>
        </div>

        <!-- Activity Tab -->
        <div class="instructions-tab-content" id="tab-activity">
          <div id="activity-list">
            <div class="instructions-empty">
              <div class="instructions-empty__icon">📊</div>
              <div class="instructions-empty__title">No activity yet</div>
              <div class="instructions-empty__text">
                When your instructions trigger actions, they'll appear here.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="/socket.io/socket.io.js"></script>
<script src="/js/instructions.js"></script>
