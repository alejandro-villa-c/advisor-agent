<div class="app-shell">
  <%- include('../partials/sidebar', { active: 'instructions' }) %>

  <main class="main-area" aria-label="Instructions">
    <div class="center-page">
      <div class="center-card">
        <div class="page-tabs" aria-label="Page navigation">
          <div class="tabs">
            <div class="tabs__left">
              <a class="tab" href="/settings">Settings</a>
              <a class="tab tab--active" href="/instructions" aria-current="page">Instructions</a>
              <a class="tab" href="/threads">History</a>
            </div>
          </div>
        </div>

        <div class="page-badge page-badge--desktop">Automation</div>
        <h1 class="page-title">Ongoing Instructions</h1>
        <p class="page-subtitle">
          Set up rules that the agent will follow automatically when events happen.
        </p>

        <% if (locals.flash) { %>
          <div class="notice <%= locals.flash.type === 'success' ? 'notice--success' : 'notice--error' %>">
            <%= locals.flash.message %>
          </div>
        <% } %>

        <!-- Rate Limit Indicator -->
        <div class="instructions-rate-limit" id="rate-limit-bar">
          <div class="instructions-rate-limit__label">
            Proactive actions this hour: <span id="rate-limit-count">—</span> / <span id="rate-limit-max">20</span>
          </div>
          <div class="instructions-rate-limit__bar">
            <div class="instructions-rate-limit__fill" id="rate-limit-fill" style="width: 0%"></div>
          </div>
        </div>

        <!-- Create New Instruction -->
        <div class="instructions-create">
          <form id="create-instruction-form">
            <input 
              type="text" 
              class="instructions-create__input" 
              name="instruction"
              placeholder="e.g., When someone emails me that's not in HubSpot, create a contact..."
              required
            >
            <div class="instructions-create__actions">
              <button type="submit" class="btn btn--primary">Add Instruction</button>
            </div>
          </form>
        </div>

        <!-- Global Actions -->
        <div class="instructions-toolbar">
          <div class="instructions-toolbar__left">
            <span class="instructions-toolbar__count" id="instruction-count">0 instructions</span>
          </div>
          <div class="instructions-toolbar__right">
            <button class="btn btn--ghost btn--small" id="pause-all-btn" title="Pause All">
              ⏸️ Pause All
            </button>
            <button class="btn btn--ghost btn--small" id="resume-all-btn" title="Resume All">
              ▶️ Resume All
            </button>
          </div>
        </div>

        <!-- Tabs -->
        <div class="instructions-tabs">
          <button class="instructions-tabs__btn instructions-tabs__btn--active" data-tab="instructions">
            📋 Instructions
          </button>
          <button class="instructions-tabs__btn" data-tab="activity">
            📊 Activity Log
          </button>
        </div>

        <!-- Instructions Tab -->
        <div class="instructions-tab-content instructions-tab-content--active" id="tab-instructions">
          <div id="instructions-list">
            <div class="instructions-empty">
              <div class="instructions-empty__icon">📋</div>
              <div class="instructions-empty__title">No instructions yet</div>
              <div class="instructions-empty__text">
                Create your first ongoing instruction above. Examples:
                <ul>
                  <li>"When someone emails me that's not in HubSpot, create a contact"</li>
                  <li>"When I create a calendar event, email the attendees"</li>
                  <li>"When a client asks about our next meeting, look it up and respond"</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

        <!-- Activity Tab -->
        <div class="instructions-tab-content" id="tab-activity">
          <div id="activity-list">
            <div class="instructions-empty">
              <div class="instructions-empty__icon">📊</div>
              <div class="instructions-empty__title">No activity yet</div>
              <div class="instructions-empty__text">
                When your instructions trigger actions, they'll appear here.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>

<script src="/js/instructions.js"></script>
