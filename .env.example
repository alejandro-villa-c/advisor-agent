# Env
NODE_ENV=development

# App
APP_BASE_URL=http://localhost:3000
INTERNAL_API_SECRET=
SESSION_SECRET=

# Database
DATABASE_URL=postgres://postgres:postgres123@localhost:5432/advisor_agent

# Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/auth/hubspot/callback
HUBSPOT_SCOPES=oauth crm.objects.contacts.read crm.objects.contacts.write
HUBSPOT_TOKEN_REFRESH_SKEW_SECONDS=120

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_CHAT_MODEL=gpt-4o-mini

# RAG
RAG_TAKE=100                      # Results to consider
RAG_SEMANTIC_CANDIDATES=500       # Semantic search pool
RAG_LEXICAL_CANDIDATES=200        # Lexical search pool
RAG_SYSTEM_CITATIONS_MAX=20       # Citations passed to LLM
RAG_SYSTEM_EXCERPT_MAX_CHARS=800  # Chars per citation

# Job Cron Expressions
SYNC_TICK_CRON=*/1 * * * *
AGENT_TICK_CRON=*/1 * * * *
INSTRUCTION_TICK_CRON=*/1 * * * *
RAG_REPAIR_CRON=*/15 * * * *

# Ongoing Instructions
PROACTIVE_ACTIONS_PER_HOUR=50